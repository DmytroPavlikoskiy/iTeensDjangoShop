# ===============================================
# 1. Django Specific
# ===============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Django stuff:
*.log
*.pot
*.mo
*.prof
htmlcov/

# Python / Pipenv virtual environments
.env

# Media files (uploaded user content)
# /my_shop/media/*
# !/my_shop/media/.gitkeep # Залишити порожню теку, якщо вона має бути в репозиторії

# Static files (generated by collectstatic)
# /my_shop/staticfiles/

# ===============================================
# 2. IDE / System Files
# ===============================================

# OSX
.DS_Store
# Windows
Thumbs.db

# JetBrains IDEs (PyCharm, WebStorm etc.)
.idea/

# VS Code
.vscode/

# ===============================================
# 3. Docker Specific
# ===============================================

# Docker secrets and sensitive data
.env # Секрети, які ви використовуєте у docker-compose

# Ignore Docker volumes (томи, створені Docker Compose)
# Вони можуть містити статичні файли, медіа та дані БД.
# У вашому випадку це:
# myministore_postgres_data/
# myministore_static_volume/
# myministore_media_volume/

# ===============================================
# 4. Local Dependencies
# ===============================================

# Dependencies (if installed locally for testing)
/env
/bin
/include
/lib
/lib64